# ─────────────────────────────────────────────────────────────────────────────
# OFTS Backend — Environment Variables
#
# Copy this file:
#   cp .env.example .env
#
# Then fill in real values for your environment.
# backend/.env is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/ofts_db
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ofts_db
MONGO_URI=mongodb://localhost:27017/ofts_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Change to a long random string in production (min 32 chars)
JWT_SECRET=ofts_super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── CORS ─────────────────────────────────────────────────────────────────────
# React Native Expo dev client / web preview origin
CLIENT_ORIGIN=http://localhost:3000

# ── File uploads ─────────────────────────────────────────────────────────────
# Path relative to the backend root where uploaded files are stored
UPLOAD_DIR=uploads
